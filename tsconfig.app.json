{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/env.d.ts", "src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/**/__tests__"],
  "compilerOptions": {
    // for vue-router/volar
    "rootDir": ".",
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "moduleDetection": "force",
    "isolatedModules": true,
    // https://github.com/vuejs/language-tools/issues/5219#issuecomment-2690477682
    "isolatedDeclarations": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "fallthroughAttributes": true,
    "inferTemplateDollarAttrs": true,
    "plugins": [
      "unplugin-vue-router/volar/sfc-route-blocks",
      "unplugin-vue-router/volar/sfc-typed-router"
    ]
  }
}
